# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Freestyle API Configuration (optional)
FREESTYLE_API_URL=https://api.freestyle.com/v1
FREESTYLE_API_TOKEN=your-freestyle-token

# Ultrahuman API Configuration (optional)
ULTRAHUMAN_API_URL=https://api.ultrahuman.com/v1
ULTRAHUMAN_API_TOKEN=your-ultrahuman-token

# Vercel/Deployment Configuration
ENVIRONMENT=development
NODE_ENV=development
